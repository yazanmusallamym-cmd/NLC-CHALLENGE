{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "settings":  { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "game":      { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "live":      { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "teams":     { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "assign":    { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "ledger":    { ".read": "auth != null && root.child('admins').child(auth.uid).exists()", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "board":     { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "notices":   { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "questions": { ".read": "auth != null && root.child('admins').child(auth.uid).exists()", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "applied":   { ".read": "auth != null && root.child('admins').child(auth.uid).exists()", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "played":    { ".read": "auth != null && root.child('admins').child(auth.uid).exists()", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },

    "teamByUid": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "counters": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$teamId": {
        ".read": "auth != null && (root.child('teamByUid').child(auth.uid).val() === $teamId || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('teamByUid').child(auth.uid).val() === $teamId",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 || root.child('admins').child(auth.uid).exists()"
      }
    },

    "players": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$teamId": {
        "$pid": {
          ".write": "auth != null && root.child('teamByUid').child(auth.uid).val() === $teamId && newData.exists()",
          ".validate": "newData.hasChildren(['name', 'number'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 61 && (!data.exists() || data.val() === newData.val() || root.child('admins').child(auth.uid).exists())" },
          "number": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val() || root.child('admins').child(auth.uid).exists())" },
          "online": { ".validate": "newData.isBoolean()" },
          "joinedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "secrets": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$qid": {
        "$teamId": {
          ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
          "$pid": { ".read": "auth != null && root.child('teamByUid').child(auth.uid).val() === $teamId" }
        }
      }
    },

    "submissions": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$qid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$teamId": {
          ".read": "auth != null && root.child('teamByUid').child(auth.uid).val() === $teamId",
          "$sid": {
            ".write": "auth != null && root.child('teamByUid').child(auth.uid).val() === $teamId && !data.exists() && newData.exists() && root.child('game/qid').val() === $qid && root.child('game/phase').val() === 'open' && (root.child('game/endsAt').val() == 0 || now <= root.child('game/endsAt').val() + 2000) && (root.child('assign').child($qid).child($teamId).child('_all').exists() || root.child('assign').child($qid).child($teamId).child(newData.child('playerId').val()).exists()) && root.child('players').child($teamId).child(newData.child('playerId').val()).exists() && (($sid === 'team') === (root.child('live/inputMode').val() === 'team')) && ($sid === 'team' || $sid === newData.child('playerId').val())",
            ".validate": "newData.hasChildren(['playerId', 'value', 'time']) && newData.child('time').val() === now",
            "value": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 61" },
            "number": { ".validate": "newData.isNumber()" },
            "hasImage": { ".validate": "newData.isBoolean()" },
            "playerId": { ".validate": "newData.isString()" },
            "time": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "spot": { ".read": "auth != null", ".write": "auth != null && root.child('admins').child(auth.uid).exists()" },
    "images": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$qid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$teamId": {
          "$sid": {
            ".write": "auth != null && root.child('teamByUid').child(auth.uid).val() === $teamId && !data.exists() && root.child('game/qid').val() === $qid && root.child('game/phase').val() === 'open' && newData.parent().parent().parent().parent().child('submissions').child($qid).child($teamId).child($sid).exists()",
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 800000"
          }
        }
      }
    }
  }
}
